{
  "name": "git-worktree-pool",
  "version": "1.0.0",
  "description": "git worktree pool module",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "bin": {
    "git-wt-pool": "./dist/bin/git-wt-pool.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run husky-install && npm run build",
    "husky-install": "node scripts/ensureHusky.js",
    "prebuild": "rimraf dist",
    "build": "tsc --build tsconfig.build.json",
    "postbuild": "add-shebang",
    "test": "jest",
    "unit_test": "jest test/unit_test",
    "integration_test": "jest test/integration_test",
    "test-ci": "jest --reporters=default --reporters=jest-junit",
    "eslint": "eslint --cache --cache-location .eslintcache/ --cache-strategy content -c .eslintrc.json --ext .ts,.js src/ test/",
    "eslint-fix": "npm run eslint -- --fix",
    "type-check": "tsc --build tsconfig.json",
    "index-generator": "ctix create -p ./tsconfig.build.json --config ./.ctirc",
    "pre-commit": "git diff HEAD --quiet -- \"*.ts\" || npm run index-generator && git add \"**/index.ts\"",
    "update-deps": "npx npm-check-updates -u -t minor"
  },
  "engines": {
    "node": ">= 22",
    "npm": ">= 10"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "clipboardy": "2.3.0"
  },
  "devDependencies": {
    "@jest/types": "30.0.5",
    "@tsconfig/node22": "22.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.16.5",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "add-shebang": "0.1.0",
    "ctix": "1.8.3",
    "eslint": "8.57.1",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "27.9.0",
    "eslint-plugin-node": "11.1.0",
    "husky": "8.0.3",
    "jest": "30.0.5",
    "jest-junit": "16.0.0",
    "rimraf": "6.0.1",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "typedoc": "0.28.8",
    "typescript": "5.8.3"
  }
}
